# EgyTrend — انسخ هذا الملف إلى `.env` وعدّل القيم (الملف الأصلي محجوب عن Git عمدًا)
# ---------------------------------------------------------------------------
# cp .env.example .env

# ── الأساسيات ──────────────────────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgres://user:password@localhost:5432/egytrend
# سر الجلسات — ولّده عشوائيًا في الإنتاج بـ: openssl rand -hex 48
SESSION_SECRET=change-me-to-a-long-random-string
# كلمة مرور لوحة المدير — جديدة وقوية في الإنتاج (ليست قيمة التطوير)
ADMIN_PASSWORD=change-me-strong-admin-password
NODE_ENV=production

# ── البريد الإلكتروني: استعادة كلمة المرور ────────────────────────────────
# (Gmail: كلمة تطبيقات 16 حرفًا من myaccount.google.com/apppasswords بعد تفعيل التحقق الثنائي)
# (Brevo: SMTP key من app.brevo.com — مجاني حتى 300 رسالة/يوم، الأنسب للإنتاج)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="EgyTrend <no-reply@yourdomain.com>"
# يُبنى منه رابط الاستعادة في رسالة البريد:
APP_BASE_URL=https://yourdomain.com

# ── اختيارية: AI حقيقي / مزودو بيانات ─────────────────────────────────────
#ANTHROPIC_API_KEY=
#FINNHUB_API_KEY=
#ALPHA_VANTAGE_API_KEY=
