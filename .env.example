# EgyTrend — انسخ هذا الملف إلى `.env` محليًا فقط، ثم ضع القيم نفسها في
# Vercel Environment Variables للبيئة المناسبة. `.env` محجوب عن Git عمدًا.
# لا تضع أي قيمة حقيقية في هذا الملف النموذجي.
# ---------------------------------------------------------------------------
# cp .env.example .env

# ── الأساسيات المطلوبة للإنتاج ────────────────────────────────────────────
PORT=8080
DATABASE_URL=postgresql://DATABASE_USER:DATABASE_PASSWORD@DATABASE_HOST:5432/egytrend
# ولّده محليًا بـ: openssl rand -hex 48 — لا تستخدم قيمة المثال.
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
# كلمة مرور قوية وفريدة للوحة المدير؛ لا تستخدم قيمة المثال.
ADMIN_PASSWORD=replace-with-a-strong-unique-admin-password
NODE_ENV=production
# رابط HTTPS الحقيقي للتطبيق؛ يُستخدم في رسائل الاستعادة وCORS.
APP_BASE_URL=https://app.your-real-domain.example
# اختياري: origins إضافية مفصولة بفاصلة. APP_BASE_URL يُضاف تلقائيًا.
#CORS_ORIGINS=https://preview.your-real-domain.example

# ── البريد الإلكتروني: مطلوب عند تفعيل الاستعادة والتنبيهات ──────────────
# لا ترسل رسائل اختبار إلى عملاء حقيقيين من بيئة development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EgyTrend <no-reply@your-real-domain.example>"
# سر webhook/cron لتنبيهات الأسعار — مولّد عشوائي وغير معروض في الواجهة.
#CRON_SECRET=

# ── Twelve Data: جميع الطلبات من backend فقط ──────────────────────────────
# لا تملأ هذه المجموعة ولا تضبط true قبل وجود موافقة مكتوبة تسمح بالعرض
# الخارجي/إعادة التوزيع لكل سوق ونوع بيانات، مع تأكيد الرموز من المزود.
TWELVE_DATA_API_KEY=
TWELVE_DATA_EXTERNAL_DISPLAY_LICENSED=false
# مرجع غير سري للعقد/طلب الشراء/موافقة الدعم؛ لا تضع نص العقد أو مفتاحًا هنا.
TWELVE_DATA_LICENSE_REFERENCE=
# رقم الدقائق الفعلي في الاتفاق. 0 مسموح فقط مع حق عرض لحظي صريح أدناه.
TWELVE_DATA_DELAY_MINUTES=
TWELVE_DATA_REALTIME_DISPLAY_LICENSED=false
# لا يسمح الموصل بأي egx:* أو stock:egx:* حتى مع العقد العام؛ يلزم تأكيد EGX مستقل.
TWELVE_DATA_EGX_DISPLAY_LICENSED=false
TWELVE_DATA_EGX_LICENSE_REFERENCE=
# JSON بمفاتيح catalog المحلية وقيم رموز Twelve المؤكدة فقط — لا تخمّن رموز EGX.
# مثال البنية فقط (ليس رمزًا صالحًا): {"fx:USD-EGP":"CONFIRMED_VENDOR_SYMBOL"}
TWELVE_DATA_SYMBOLS_JSON={}

# ── كتابة تاريخ السوق (تظل معطلة حتى backup + migration + job موثّق) ─────
MARKET_SNAPSHOT_WRITES_ENABLED=false
#MARKET_SNAPSHOT_CRON_SECRET=

# ── AI اختياري؛ لا تفعّله ما لم توجد موافقة/ميزانية تشغيلية ───────────────
#ANTHROPIC_API_KEY=
#AI_INTEGRATIONS_ANTHROPIC_API_KEY=
#GOOGLE_API_KEY=

# ── الجلسات والأمان: قيم تُدار يدويًا في Vercel ────────────────────────────
# عند تدوير SESSION_SECRET: ضع القيمة القديمة هنا أولًا حتى يمكن للموظفين
# الذين ما زالوا على hashes قديمة (peppered) الدخول مرة واحدة وترقية
# hashهم إلى scrypt، ثم احذفها بعد أسبوعين من التأكد.
#SESSION_SECRET_PREVIOUS=
# هل الموظفون يتشاركون جلسات المستخدمين؟ (افتراضي: لا — أبقها false)
#AUTH_SHARED_SESSIONS=
# عدد الـproxy hops أمام الـAPI خارج Vercel (على Vercel: 1 تلقائيًا).
#TRUST_PROXY_HOPS=
# يسمح لبيئات Vercel Preview بالوصول إلى الـAPI (true فقط أثناء التطوير).
#ALLOW_VERCEL_PREVIEW=
# يساوي CORS_ORIGINS في بعض المسارات — أبقِهما متطابقين إن استخدمتَ الاثنين.
#ALLOWED_ORIGINS=
# تشغيل migrations تلقائيًا عند الإقلاع (الإنتاج: false — شغّلها يدويًا بعد مراجعة).
#DB_AUTO_MIGRATE=
# مفتاح الطوارئ "كسر الزجاج" للدخول بكلمة المدير القديمة: on فقط عند الطوارئ.
#ADMIN_BREAK_GLASS=
#LOG_LEVEL=info

# ── أسرار توقيع إضافية (ولّدها: openssl rand -base64 32) ─────────────────
#تُستخدم لإشارة referral — اتركها فارغة لمعطلته.
#REFERRAL_COOKIE_SECRET=
#REFERRAL_SIGNAL_SECRET=
#TRIAL_SIGNAL_SECRET=

# ── النسخ الاحتياطي: أدوات السكربت (scripts/backup-db.mjs / restore-db.mjs) ─
# مسارات pg_dump / psql إن لم تكونا على PATH.
#PG_DUMP_BIN=
#PSQL_BIN=
# مفتاح تشفير النسخ (AES-256-GCM). وّلبه محليًا: openssl rand -hex 32
# ثم احفظه في مدير كلمات المرور — لا في Git ولا في الـrepo.
# يُفضّل ملف مفتاح على ويندوز:
#EGYTREND_BACKUP_KEY=
#EGYTREND_BACKUP_KEYFILE=C:\Users\<you>\AppData\Local\EgyTrend\backup.key

# ── AI إضافي (اختياري، مرتبط بميزانية/موافقة) ────────────────────────────
#ANTHROPIC_MODEL=
#AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
#AI_INTEGRATIONS_GOOGLE_API_KEY=
#GOOGLE_GENERATIVE_AI_API_KEY=
#GEMINI_API_KEY=
#GEMINI_BASE_URL=
#GEMINI_MODEL=
#GEMINI_MODEL_FALLBACKS=
#GEMINI_ATTEMPT_TIMEOUT_MS=
#AI_PER_PRINCIPAL_DAILY_HARD_CAP=
#AI_GLOBAL_DAILY_HARD_CAP=

# ── تنبيهات جودة البيانات (اختياري) ─────────────────────────────────────
#DATA_SOURCE_ALERTS_ENABLED=false
#DATA_ALERT_EMAIL=
#LEGACY_MARKET_FEEDS_DISABLED=
