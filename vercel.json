{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node vercel-build.mjs",
  "outputDirectory": "artifacts/egytrend/dist/public",
  "functions": {
    "api/egytrend.mjs": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/**,artifacts/api-server/node_modules/**,node_modules/.pnpm/**,lib/db/dist/**,lib/db/node_modules/**,lib/api-zod/dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/egytrend"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
